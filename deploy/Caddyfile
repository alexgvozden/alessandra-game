# game-web's own config: serves dist/ on :80 inside the container.
# The public site block for game.getperformant.com lives in the server's front Caddy.
:80 {
	root * /srv
	encode zstd gzip

	# Vite's hashed bundles (name-AbCd1234.js) never change; the page always revalidates.
	@hashed path_regexp ^/assets/[^/]+-[-_A-Za-z0-9]{8}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html
	header @page Cache-Control "no-cache"

	file_server
}
