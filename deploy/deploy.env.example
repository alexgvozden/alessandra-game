# Copy to deploy/deploy.env (ignored by git) and fill in.
# SSH target for the server that runs the game-web container.
DEPLOY_HOST=user@your-server
# Folder on the server that holds docker-compose.yml, Caddyfile and dist/.
DEPLOY_DIR=/opt/word-magic
# External Docker network shared with the server's front Caddy.
EDGE_NETWORK=edge
